[Unit]
Description=AICF site-gateway (HTTP 127.0.0.1:18080, gRPC mTLS :17443)
After=network-online.target docker.service aicf-sidecar.service aicf-dagapi.service
Wants=network-online.target 
PartOf=aicf.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric
EnvironmentFile=/etc/aicf/aicf.env
Environment=PYTHONPATH=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric
Environment=LD_LIBRARY_PATH=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/.aicf-work/bin
ExecStart=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/bin/site-gateway -grpc 0.0.0.0:17443 -http 127.0.0.1:18080 -tenants-file /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/tenants.json -topology-file /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/topology.json -allow-signup -signup-auto-approve -default-thinking off -max-wait 60s -tls-cert /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/pki/gateway.crt -tls-key /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/pki/gateway.key -tls-client-ca /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/pki/ca.crt -vram-sidecar-url http://127.0.0.1:18095 -audit-log /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/audit.jsonl -agents-url http://127.0.0.1:18096 -studio-url http://127.0.0.1:18098 -bestofn-url http://127.0.0.1:18099 -serverless-url http://127.0.0.1:18110 -serverless-secret-file /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/serverless.secret
Restart=always
RestartSec=5
# Outside user@1000.service, so systemd-oomd's user-session kills (e.g. a Chromium scope) cannot take it down.
ManagedOOMPreference=avoid
OOMScoreAdjust=-300

[Install]
WantedBy=aicf.target
