[Unit]
Description=AICF Serverless GPU/Python service
After=network-online.target docker.service aicf-gateway.service
Wants=network-online.target 
PartOf=aicf.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric
EnvironmentFile=/etc/aicf/aicf.env
Environment=PYTHONPATH=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric
Environment=LD_LIBRARY_PATH=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/.aicf-work/bin
ExecStart=/mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.venv/bin/python -m serverless.app --listen 127.0.0.1:18110 --gateway http://127.0.0.1:18080 --secret-file /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/serverless.secret --data-dir /mnt/2d4726e7-046b-47c7-b9a9-d2a9cc0cfc8d/Work/AIComputeFabric/ai-compute-fabric/.demo/serverless --worker-id pc-001 --gpu-enabled --gpu-index 0 --headroom-mib 512 --control-port 18111 --canary-tenant demo --canary-gpu-allowed --canary-max-vram-mb 4096 --default-enabled
Restart=always
RestartSec=5
# Outside user@1000.service, so systemd-oomd's user-session kills (e.g. a Chromium scope) cannot take it down.
ManagedOOMPreference=avoid
OOMScoreAdjust=-300

[Install]
WantedBy=aicf.target
