[Unit]
Description=AICF Serverless GPU Control Plane (Modal/Beta9 Compatible)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=aicf
Group=aicf
SupplementaryGroups=docker video render
WorkingDirectory=/opt/aicf
EnvironmentFile=/etc/aicf/serverless.env
ExecStart=/opt/aicf/.venv/bin/python -m agents.serverless_service \
  --host 127.0.0.1 \
  --port 18110 \
  --gpu-sandbox \
  --vram-budget-mb ${AICF_VRAM_BUDGET_MB} \
  --data-dir /var/lib/aicf/serverless \
  --audit-log /var/log/aicf/serverless_audit.jsonl
Restart=on-failure
RestartSec=3
TimeoutStopSec=35

# Systemd Hardening (Pha B2)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/aicf /var/log/aicf
ReadOnlyPaths=/etc/aicf

[Install]
WantedBy=multi-user.target
