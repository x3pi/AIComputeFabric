[Unit]
Description=AICF Worker Guard (6-Bucket VRAM Telemetry & Reclaim Agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aicf
Group=aicf
SupplementaryGroups=video render
WorkingDirectory=/opt/aicf/apps/worker-guard
EnvironmentFile=/etc/aicf/worker-guard.env
ExecStart=/opt/aicf/bin/worker-guard \
  -worker-id=${AICF_WORKER_ID} \
  -gateway=${AICF_GATEWAY_GRPC} \
  -tls-dir=/etc/aicf/pki \
  -control-addr=127.0.0.1:8099 \
  -control-token=${AICF_CONTROL_TOKEN} \
  -rpc-bind=${AICF_RPC_BIND_IP}:50052
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Systemd Hardening (Pha B2)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/aicf /var/log/aicf
ReadOnlyPaths=/etc/aicf

[Install]
WantedBy=multi-user.target
