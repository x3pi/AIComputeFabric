[Unit]
Description=AICF AI Studio Service (RAG, Prompt Registry, LoRA & Audio AI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aicf
Group=aicf
WorkingDirectory=/opt/aicf
EnvironmentFile=/etc/aicf/studio.env
ExecStart=/opt/aicf/.venv/bin/python -m agents.studio_service \
  --host 127.0.0.1 \
  --port 18090 \
  --data-dir /var/lib/aicf/studio
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Systemd Hardening (Pha B2)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/aicf /var/log/aicf
ReadOnlyPaths=/etc/aicf

[Install]
WantedBy=multi-user.target
