# Chi cho phep engine llama-server (:18090) tu: chinh may nay (lo, gom ca goi toi IP LAN 192.168.1.40 cua gateway)
# va Windows 10.42.0.225 qua cap truc tiep. Moi nguon khac (LAN/Wi-Fi) bi chan; di qua gateway :18080 (co key).
table inet aicf_engine {
  chain input {
    type filter hook input priority -10; policy accept;
    tcp dport 18090 iifname "lo" accept
    tcp dport 18090 iifname "enp133s0" ip saddr 10.42.0.225 accept
    tcp dport 18090 counter drop
  }
}
